# =============================================================================
# Variables de entorno — Dokploy / Docker Compose
# =============================================================================
#
# En Dokploy:
#   1. Compose Path: ./docker-compose.yml  (con el punto al inicio)
#   2. Pega este contenido en Environment del servicio Compose
#   3. Domains → servicio erp → puerto 3000 + HTTPS
#      Dominio producción: erp.tudominio.com (reemplazar por el tuyo)
#   4. Acceso por IP: http://IP_DEL_VPS:8080 (mapeo host 8080 → contenedor 3000)
#
# Obligatorios: DB_PASS, JWT_SECRET, PUBLIC_BASE_URL, CORS_ORIGINS
# Si cambia la IP del VPS, actualiza el segundo origen en CORS_ORIGINS.
#
# Tras desplegar modelos nuevos, una sola vez puede activar:
# DB_SYNC_ALTER=true
# (luego quitarlo; en producción el sync va sin alter por defecto)
#
# =============================================================================

TZ=America/Bogota

# PostgreSQL (servicio postgres del compose — no expuesto a internet)
DB_NAME=erp_techstore
DB_USER=erp_user
DB_PASS=tu_contraseña_segura

# Autenticación JWT (obligatorio — mínimo 32 caracteres)
JWT_SECRET=genera_una_clave_aleatoria_de_32_caracteres_o_mas
JWT_EXPIRES_IN=8h

# URL canónica (enlaces públicos / HTTPS del dominio Dokploy)
PUBLIC_BASE_URL=https://erp.tudominio.com

# CORS: dominio HTTPS + acceso directo por IP:8080 (separados por coma)
CORS_ORIGINS=https://erp.tudominio.com,http://IP_DEL_VPS:8080

# Opcional — Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Opcional — SMTP (también configurable desde la UI)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
