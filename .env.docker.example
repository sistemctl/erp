# =============================================================================
# Variables de entorno — Dokploy / Docker Compose
# =============================================================================
#
# En Dokploy:
#   1. Compose Path: ./docker-compose.yml
#   2. Pega este contenido en la pestaña Environment del servicio Compose
#   3. Domains → servicio erp → puerto 3000 + HTTPS
#   4. Acceso directo por IP del VPS: http://IP:8080 (mapeo host 8080 → contenedor 3000)
#
# Obligatorios: DB_PASS, JWT_SECRET, PUBLIC_BASE_URL, CORS_ORIGINS
#
# =============================================================================

TZ=America/Bogota

# PostgreSQL (servicio postgres del compose — no expuesto a internet)
DB_NAME=erp_techstore
DB_USER=erp_user
DB_PASS=tu_contraseña_segura

# Autenticación JWT (obligatorio — mínimo 32 caracteres)
JWT_SECRET=genera_una_clave_aleatoria_de_32_caracteres_o_mas
JWT_EXPIRES_IN=8h

# URL pública y CORS (mismo dominio que configures en Dokploy → Domains)
PUBLIC_BASE_URL=https://erp.tudominio.com
CORS_ORIGINS=https://erp.tudominio.com

# Opcional — Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Opcional — SMTP (también configurable desde la UI)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
