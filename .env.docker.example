# Copie este archivo a .env en la raíz del repositorio para Docker Compose:
#   cp .env.docker.example .env
#
# Luego levante el stack:
#   docker compose -f docker-compose.erp.yml up -d --build

TZ=America/Bogota

# Puerto expuesto en el host (contenedor ERP siempre escucha en 3000)
ERP_HOST_PORT=3000

# PostgreSQL (servicio postgres del compose)
DB_NAME=erp_techstore
DB_USER=erp_user
DB_PASS=cambiar_contraseña_segura

# Autenticación JWT (obligatorio — mínimo 32 caracteres)
JWT_SECRET=cambiar_por_clave_larga_y_aleatoria_minimo_32_caracteres
JWT_EXPIRES_IN=8h

# URL pública y CORS (recomendado en producción detrás de Nginx/HTTPS)
# PUBLIC_BASE_URL=https://erp.midominio.com
# CORS_ORIGINS=https://erp.midominio.com

# Opcional — Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Opcional — SMTP (también configurable desde la UI)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
