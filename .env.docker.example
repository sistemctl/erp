# =============================================================================
# Variables de entorno — Docker / Dokploy
# =============================================================================
#
# Local:
#   cp .env.docker.example .env
#   docker compose -f docker-compose.erp.yml up -d --build
#
# Dokploy (compose: ./docker-compose.yml):
#   Pega este contenido en la pestaña Environment del servicio Compose.
#   Obligatorios: DB_PASS, JWT_SECRET, PUBLIC_BASE_URL, CORS_ORIGINS
#   Dominio: pestaña Domains → servicio erp → puerto 3000
#
# =============================================================================

TZ=America/Bogota

# Solo local (docker-compose.erp.yml). En Dokploy no hace falta.
ERP_HOST_PORT=3000

# PostgreSQL (servicio postgres del compose)
DB_NAME=erp_techstore
DB_USER=erp_user
DB_PASS=tu_contraseña_segura

# Autenticación JWT (obligatorio — mínimo 32 caracteres)
JWT_SECRET=genera_una_clave_aleatoria_de_32_caracteres_o_mas
JWT_EXPIRES_IN=8h

# URL pública y CORS (obligatorio en producción / Dokploy con HTTPS)
# Usa el mismo dominio que configures en Dokploy → Domains
PUBLIC_BASE_URL=https://erp.tudominio.com
CORS_ORIGINS=https://erp.tudominio.com

# Opcional — Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Opcional — SMTP (también configurable desde la UI)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
