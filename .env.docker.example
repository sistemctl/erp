# =============================================================================
# Variables de entorno — Docker Compose
# =============================================================================
#
# Copie este archivo como .env junto a docker-compose.yml y complete los valores:
#   cp .env.docker.example .env
#   docker compose up -d --build
# Acceso por IP: http://IP_DEL_VPS:8080 (mapeo host 8080 → contenedor 3000)
#
# Obligatorios: DB_PASS, JWT_SECRET, PUBLIC_BASE_URL, CORS_ORIGINS
# Si cambia la IP del VPS, actualiza el segundo origen en CORS_ORIGINS.
#
# Tras desplegar modelos nuevos, una sola vez puede activar:
# DB_SYNC_ALTER=true
# (luego quitarlo; en producción el sync va sin alter por defecto)
#
# =============================================================================

TZ=America/Bogota

# PostgreSQL (servicio postgres del compose — no expuesto a internet)
DB_NAME=erp_techstore
DB_USER=erp_user
DB_PASS=tu_contraseña_segura

# Autenticación JWT (obligatorio — mínimo 32 caracteres)
# Genere con: openssl rand -hex 32  (mínimo 32 caracteres; si es más corto el servidor lo advierte al arrancar)
JWT_SECRET=genera_una_clave_aleatoria_de_32_caracteres_o_mas
JWT_EXPIRES_IN=8h

# URL canónica (enlaces públicos / HTTPS del dominio)
PUBLIC_BASE_URL=https://erp.tudominio.com

# CORS: dominio HTTPS + acceso directo por IP:8080 (separados por coma)
CORS_ORIGINS=https://erp.tudominio.com,http://IP_DEL_VPS:8080

# Proxies de confianza para la IP real del cliente (límite de intentos de login).
# Vacío = solo proxies en red privada (Nginx local, Docker). Use "1" si hay un único
# proxy público delante, o "false" si nadie hay delante.
TRUST_PROXY=

# Opcional — Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Opcional — SMTP (también configurable desde la UI)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
