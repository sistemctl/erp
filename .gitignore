# Dependency directories
node_modules/
backend/node_modules/
frontend/node_modules/
backend/dist/
frontend/dist/

# Environment files
.env
backend/.env
frontend/.env
.env.*
!.env.docker.example
!**/.env.example

# Runtime data stays on the machine, never in the public repository.
backend/uploads/
backend/logs/

# Temporary and log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Scratch files
scratch/
backend/scratch/

# Database dumps and backups (never commit)
*.sql
*.backup
backup_*.json
erp_*.sql
erp_*.backup

# One-off / local tooling
temp_deploy/
.agents/
.cursor/skills/
skills-lock.json

# Generated audit evidence may contain local business data.
# Keep the reproducible scripts and written reports in Git.
audits/**/*.png
audits/**/*.jpg
audits/**/*.jpeg
audits/**/*.webp
audits/**/*.pdf
audits/**/*.json
audits/**/*.txt
