# Entorno
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_techstore
DB_USER=postgres
DB_PASS=

# Origen Odoo (migración: node scripts/migrate-odoo.js --dry-run | --execute)
# ODOO_DB_HOST=localhost
# ODOO_DB_PORT=5432
# ODOO_DB_NAME=odoo_db
# ODOO_DB_USER=postgres
# ODOO_DB_PASS=

# Autenticación JWT (obligatorio en producción)
JWT_SECRET=cambiar_por_clave_larga_y_aleatoria_minimo_32_caracteres
JWT_EXPIRES_IN=8h

# URL canónica (enlaces públicos). En Dokploy/producción:
# PUBLIC_BASE_URL=https://starsystem.turnocedes.com

# Orígenes permitidos por CORS (separados por coma).
# En desarrollo las IPs LAN privadas (192.168.x.x) se permiten automáticamente.
# En producción (NODE_ENV=production) debe listar dominio e IP de acceso directo.
# Si cambia la IP del VPS, actualiza el segundo origen.
# CORS_ORIGINS=https://starsystem.turnocedes.com,http://187.33.148.48:8080

# Google Gemini AI (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SMTP (opcional — la configuración principal también se guarda en Configuración → Notificaciones)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Twilio SMS/WhatsApp (opcional — también configurable desde la UI)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Directorio de archivos subidos
UPLOAD_DIR=uploads/reparaciones
