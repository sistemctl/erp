# IP de la máquina donde corre Docker (la usan Pi-hole DNS y los clientes de la red)
HOST_IP=192.168.1.50

TZ=America/Bogota

# Contraseña del panel web de Pi-hole
PIHOLE_WEBPASSWORD=cambiar-esta-clave

# ERP en el host Windows (Servitec Gamers suele usar 8080)
ERP_PORT=8080

# Dominios locales (deben coincidir con nginx/servitec.conf y los certificados mkcert)
DOMAIN_ERP=erp.servitec.local
DOMAIN_ERP_ALT=servitec.erp.local
DOMAIN_PIHOLE=servitec.pi-hole.local
